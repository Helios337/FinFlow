# ---- Database ----
POSTGRES_USER=financeops
POSTGRES_PASSWORD=financeops
POSTGRES_DB=financeops
POSTGRES_HOST=localhost
# docker-compose maps container 5432 to host 5433
POSTGRES_PORT=5433

# Read-only role used by the FastAPI backend / AI copilot (SELECT-only).
# Created by sql/readonly_role.sql via python/persist.py.
POSTGRES_RO_USER=financeops_ro
POSTGRES_RO_PASSWORD=financeops

# ---- AI Copilot ----
# Any OpenAI-compatible endpoint. Leave OPENAI_API_KEY empty to use the
# built-in stub (rule-based answers) so the project runs without a key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---- App ----
APP_ENV=dev
LOG_LEVEL=INFO
